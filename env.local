# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_, never import from client code.
# Used solely to send invitations, after the caller's members.manage
# permission has been checked.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app, used in invitation and sign-in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The conference this deployment serves (matches supabase/seed.sql).
CONFERENCE_SLUG=contech-nigeria-2026
